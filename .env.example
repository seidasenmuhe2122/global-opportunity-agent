DJANGO_SECRET_KEY=
DEBUG=1
SECURE_SSL_REDIRECT=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=
# Local development Redis only. Production must provide the shared Redis URL.
REDIS_URL=redis://localhost:6379/0
# Optional overrides; defaults to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=UTC
PLAYWRIGHT_STATE_DIR=playwright_state
BROWSER_HEADLESS=1
BROWSER_TIMEOUT_MS=30000
SOURCE_CANDIDATE_BATCH_SIZE=50
TELEGRAM_POST_RETRY_MAX_ATTEMPTS=5
TELEGRAM_POST_RETRY_BASE_SECONDS=60
TELEGRAM_POST_RETRY_MAX_SECONDS=21600
DISCOVERY_MAX_PER_CYCLE=20
DISCOVERY_PAGE_SIZE=20
APPLICATION_WORKFLOW_BUDGET_SECONDS=900
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI: use any OpenAI-compatible provider or one of the fallback keys
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai-compatible
AI_TIMEOUT=30
AI_GOOGLE_API_KEY=
AI_GROQ_API_KEY=
AI_OPENROUTER_API_KEY=
AI_MISTRAL_API_KEY=
AI_TOGETHER_API_KEY=
AI_HUGGINGFACE_API_KEY=

# Telegram bot notifications/admin commands
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# Optional Telegram public-channel collection with Telethon
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=opportunity_hub

# Optional: separate secret used to encrypt saved website credentials. Keep it stable across deployments.
CREDENTIAL_ENCRYPTION_KEY=
